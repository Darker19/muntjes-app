<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Achtergrond in de lichte kleur van het kind (via setColorFilter) -->
    <ImageView
        android:id="@+id/achtergrond"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_achtergrond"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Bovenste rij: mascotte, naam, saldo en sterren -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mascotte"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/munt"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/naam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/app_naam"
                    android:textColor="#1D2733"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/eenheid"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/munt"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/saldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="–"
                        android:textColor="#1D2733"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/woord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textColor="#3E4855"
                        android:textSize="14sp" />

                    <!-- Sterren van deze week, naast het saldo -->
                    <ImageView
                        android:id="@+id/ster_icoon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:src="@drawable/ster"
                        android:visibility="gone"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/sterren"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#7A4A00"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/regel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#3E4855"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Verschijnt als er een nieuwe versie van de widget-app is -->
            <TextView
                android:id="@+id/update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/update_label"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Update"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Gekozen taken van deze week (maximaal 3 regels) -->
        <LinearLayout
            android:id="@+id/taken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/taak1" style="@style/TaakRegel" />
            <TextView android:id="@+id/taak2" style="@style/TaakRegel" />
            <TextView android:id="@+id/taak3" style="@style/TaakRegel" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
